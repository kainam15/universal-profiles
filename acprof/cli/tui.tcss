Screen {
    layout: vertical;
    background: $background;
}

* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $accent 65%;
    scrollbar-color-hover: $accent;
    scrollbar-color-active: $accent;
    scrollbar-corner-color: $surface;
}

VerticalScroll, TextArea, DataTable, #command-preview { scrollbar-size: 1 1; }

/* Keep the title bar one row tall, including Textual's click-expanded state. */
Header, Header.-tall { height: 1; background: $surface; color: $text; }
HeaderIcon, HeaderClockSpace { display: none; }
#quit-app {
    dock: right;
    width: 5;
    min-width: 5;
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
    background: $surface;
    color: $text-muted;
    content-align: center middle;
}
#quit-app:hover, #quit-app:focus {
    background: $error;
    color: $background;
    text-style: bold;
}
TabbedContent { height: 1fr; }
#experiment-pages { height: 1fr; }
TabPane { padding: 0; }
Tabs { background: $surface; }
Tab { padding: 0 2; }
Tab.-active { color: $accent; text-style: bold; }
Tabs:focus Tab.-active { color: $background; background: $accent; }
Underline { color: $accent; }

.pane-scroll { padding: 0 2; }
.section-title {
    text-style: bold;
    color: $text;
    height: 1;
    margin: 1 0;
}
.page-hint { color: $text-muted; height: auto; margin-bottom: 1; }
.form-grid {
    grid-size: 4;
    grid-columns: 16 1fr 18 1fr;
    grid-gutter: 0 1;
    height: auto;
}
.form-grid Label {
    height: 3;
    content-align: left middle;
    color: $text-muted;
}
Input, Select { width: 1fr; }
Input {
    background: $surface;
    border: tall $panel;
    padding: 0 1;
}
Input:focus { border: tall $accent; }
SelectCurrent { background: $surface; border: tall $panel; }
Select:focus > SelectCurrent { border: tall $accent; }

#preset-hint { height: 3; content-align: left middle; color: $text-muted; }
#config-summary {
    height: auto;
    min-height: 2;
    border-left: thick $accent;
    padding: 0 1;
    margin: 1 0;
    color: $text-muted;
}
#command-details { height: auto; margin-bottom: 1; border: none; background: $surface; padding: 0; }
#command-preview { height: auto; max-height: 8; overflow-y: auto; padding: 0 1; }
#science-note { height: auto; color: $text-muted; margin-top: 1; }

.action-bar {
    dock: bottom;
    height: 4;
    padding: 0 2;
    align-horizontal: right;
    border-top: solid $panel;
    background: $surface;
}
/* Transparent fill keeps the terminal cells outside rounded corners clear. */
Button {
    min-width: 14;
    height: 3;
    padding: 0 1;
    background: transparent;
    background-tint: transparent;
    tint: transparent;
    border: round $secondary;
    color: $text;
    text-style: none;
}
Button.-primary { text-style: bold; }
Button:hover, Button:focus {
    border: round $accent;
    color: $accent;
    text-style: bold underline;
}
Button.-primary, Button.-primary:focus {
    border: round $primary;
    color: $primary;
}
Button.-success, Button.-success:focus {
    border: round $success;
    color: $success;
}
Button.-warning, Button.-warning:focus {
    border: round $warning;
    color: $warning;
}
Button.-error, Button.-error:focus {
    border: round $error;
    color: $error;
}
Button.-primary:hover, Button.-success:hover, Button.-warning:hover, Button.-error:hover {
    border: round $foreground;
    color: $foreground;
}
Button.-active { text-style: bold underline; }
Button:disabled, Button:disabled:hover, Button:disabled:focus, Button:disabled.-active {
    border: round $secondary;
    color: $text;
    text-style: none;
    opacity: 45%;
}
.action-bar Button { margin-left: 1; }
#open-run-settings { margin-left: 0; width: 18; }
#action-spacer { width: 1fr; }
.button-row { height: auto; margin: 1 0; }
.button-row Button { margin-right: 1; }

.checkbox-row { height: auto; margin: 1 0; }
.option-checkbox { margin-right: 1; background: transparent; border: tall transparent; }
.option-checkbox > .toggle--button { color: $text-muted; background: $panel; }
.option-checkbox.-on > .toggle--button { color: $background; background: $accent; }
.option-checkbox:focus { border: tall $accent; }
#profile-tools {
    column-span: 3;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 3;
    height: 6;
}
#profile-tools .option-checkbox { width: 1fr; margin-right: 0; }
#profile-tools .option-checkbox > .toggle--button { color: $panel; }
#profile-tools .option-checkbox.-on > .toggle--button { color: $background; }
#allow-cgroup-v1 { display: none; }
.settings-options { height: auto; margin: 1 0; }
#settings-status { height: auto; min-height: 1; padding: 0 2; color: $accent; }
#saved-run-summary { height: auto; border-left: thick $accent; padding: 0 1; margin-bottom: 1; }

#status-grid {
    grid-size: 4;
    grid-columns: 12 1fr 12 1fr;
    grid-gutter: 0 1;
    height: auto;
    padding: 0 1;
    margin-top: 1;
    background: $surface;
}
#status-grid .status-label { color: $text-muted; }
#status-detail { height: 1; text-overflow: ellipsis; }
#case-progress { margin-top: 1; }
#log-panel { height: 1fr; min-height: 5; padding: 0; }
#log-toolbar { height: 3; }
#log-title { width: 1fr; height: 3; content-align: left middle; text-style: bold; color: $accent; }
#log-toolbar Button {
    min-width: 12;
    padding: 0;
    margin-left: 1;
}
#log-hint { height: 1; color: $text-muted; text-overflow: ellipsis; }
#restore-log { display: none; }
#log-panel.-maximized { padding: 0 1; }
#log-panel.-maximized #expand-log { display: none; }
#log-panel.-maximized #restore-log { display: block; }
#run-log {
    height: 1fr;
    min-height: 3;
    border: round $panel;
    padding: 0 1;
    background: $surface;
}
#run-log:focus { border: round $accent; }
#run-log .text-area--selection { background: $accent; color: $background; }
#result-summary { height: auto; min-height: 5; background: $surface; padding: 1; margin-top: 1; }
#matrix-board { margin-top: 1; border: none; padding: 0; }
#matrix-board > Contents { padding: 0 1; }
#matrix-table { height: auto; max-height: 12; }
.stage-idle { color: $text-muted; }
.stage-running { color: $accent; text-style: bold; }
.stage-measuring { color: $warning; text-style: bold; }
.stage-success { color: $success; text-style: bold; }
.stage-error { color: $error; text-style: bold; }

#bottom-panel { dock: bottom; height: 5; background: $background; }
#slash-command-bar { height: 5; padding: 1 2; }
#slash-command { height: 3; border: round $panel; }
#slash-command:focus { border: round $accent; }
#bottom-panel.command-hidden { height: 0; }
#bottom-panel.command-hidden #slash-command-bar { display: none; }

/* Terminal cells, not pixels: stack fields when labels would squeeze inputs. */
AcprofTui.narrow .form-grid { grid-size: 2; grid-columns: 18 1fr; }
AcprofTui.narrow #profile-tools { column-span: 1; }
AcprofTui.narrow #preset-hint, AcprofTui.narrow #preset-hint-label { display: none; }
AcprofTui.narrow .checkbox-row { layout: vertical; }
AcprofTui.narrow .button-row { layout: grid; grid-size: 2; grid-gutter: 0 1; }
AcprofTui.narrow #status-grid { grid-columns: 9 1fr 9 1fr; }
AcprofTui.narrow Tab { padding: 0 1; }
AcprofTui.short #bottom-panel { height: 3; }
AcprofTui.short #slash-command-bar { height: 3; padding: 0 2; }
AcprofTui.short #bottom-panel.command-hidden { height: 0; }
AcprofTui.short .section-title { margin: 0 0 1 0; }
AcprofTui.short #matrix-table { max-height: 3; }
AcprofTui.short #status-grid { padding: 0 1; margin-top: 0; }
AcprofTui.short #case-progress { margin-top: 0; }
AcprofTui.short #matrix-board { margin-top: 0; }
AcprofTui.short #confirm-dialog { padding: 0 2; }
