{
  "schema_version": 2,
  "extensions": [
    {
      "extension_id": "onnxruntime-cpu",
      "family": "structured",
      "runtime": "onnxruntime",
      "backends": [
        "onnxruntime"
      ],
      "tasks": [
        "tabular-classification",
        "tabular-regression"
      ],
      "handler_entrypoint": "acprof.container.handlers.onnxruntime:ONNXRuntimeHandler",
      "validation_entrypoint": "acprof.container.validation:validate_output",
      "execution_entrypoint": "",
      "environments": {
        "cpu": "onnxruntime-cpu"
      },
      "execution": {
        "cpu": "available",
        "cuda": "unsupported",
        "batch": "available",
        "streaming": "unsupported"
      },
      "measurement": {
        "latency": "available",
        "torch_profiler_eager": "unsupported",
        "gpu_power": "unsupported",
        "gpu_flops": "unsupported",
        "ncu": "unsupported",
        "nsys": "unsupported"
      },
      "dtypes": [
        "FP32"
      ],
      "input_modalities": [
        "tabular"
      ],
      "environment": "onnxruntime-cpu",
      "profile": "onnxruntime-cpu",
      "workload_entrypoint": "acprof.workloads.structured:StructuredWorkloadGenerator",
      "precision": {
        "cpu": null,
        "gpu": null
      },
      "dependency_environment": {
        "platform": "python-cpu",
        "requirements_lock": "dockerfiles/locks/onnxruntime-cpu.txt",
        "requirements_inputs": [
          "dockerfiles/requirements/onnxruntime.in"
        ],
        "runtime": {
          "type": "onnxruntime",
          "version": "1.23.2",
          "package": ""
        }
      }
    },
    {
      "extension_id": "onnxruntime-cv-cpu",
      "family": "cv",
      "runtime": "onnxruntime",
      "backends": [
        "onnxruntime"
      ],
      "tasks": [
        "image-classification"
      ],
      "handler_entrypoint": "acprof.container.handlers.onnx_tasks:ONNXImageClassificationHandler",
      "validation_entrypoint": "acprof.container.validation:validate_output",
      "execution_entrypoint": "",
      "environments": {
        "cpu": "onnxruntime-cpu"
      },
      "execution": {
        "cpu": "available",
        "cuda": "unsupported",
        "batch": "unsupported",
        "streaming": "unsupported"
      },
      "measurement": {
        "latency": "available",
        "torch_profiler_eager": "unsupported",
        "gpu_power": "unsupported",
        "gpu_flops": "unsupported",
        "ncu": "unsupported",
        "nsys": "unsupported"
      },
      "dtypes": [
        "FP32"
      ],
      "input_modalities": [
        "image"
      ],
      "environment": "onnxruntime-cpu",
      "profile": "onnxruntime-cv-cpu",
      "workload_entrypoint": "acprof.workloads.cv:CVWorkloadGenerator",
      "precision": {
        "cpu": null,
        "gpu": null
      }
    },
    {
      "extension_id": "onnxruntime-nlp-cpu",
      "family": "nlp",
      "runtime": "onnxruntime",
      "backends": [
        "onnxruntime"
      ],
      "tasks": [
        "text-classification"
      ],
      "handler_entrypoint": "acprof.container.handlers.onnx_tasks:ONNXTextClassificationHandler",
      "validation_entrypoint": "acprof.container.validation:validate_output",
      "execution_entrypoint": "",
      "environments": {
        "cpu": "onnxruntime-cpu"
      },
      "execution": {
        "cpu": "available",
        "cuda": "unsupported",
        "batch": "available",
        "streaming": "unsupported"
      },
      "measurement": {
        "latency": "available",
        "torch_profiler_eager": "unsupported",
        "gpu_power": "unsupported",
        "gpu_flops": "unsupported",
        "ncu": "unsupported",
        "nsys": "unsupported"
      },
      "dtypes": [
        "FP32"
      ],
      "input_modalities": [
        "text"
      ],
      "environment": "onnxruntime-cpu",
      "profile": "onnxruntime-nlp-cpu",
      "workload_entrypoint": "acprof.workloads.nlp:NLPWorkloadGenerator",
      "precision": {
        "cpu": null,
        "gpu": null
      }
    }
  ],
  "library_backends": {
    "onnx": "onnxruntime",
    "onnxruntime": "onnxruntime"
  },
  "backend_rules": [
    {
      "family": "structured",
      "libraries": [
        "onnx",
        "onnxruntime"
      ],
      "backend": "onnxruntime",
      "priority": 100
    },
    {
      "family": "cv",
      "libraries": [
        "onnx",
        "onnxruntime"
      ],
      "backend": "onnxruntime",
      "priority": 100
    },
    {
      "family": "nlp",
      "libraries": [
        "onnx",
        "onnxruntime"
      ],
      "backend": "onnxruntime",
      "priority": 100
    },
    {
      "backend": "onnxruntime",
      "priority": 1000,
      "when_config": {
        "export_only_onnx": true
      },
      "artifact": true
    }
  ]
}
