# Copy to .env or .env.local and fill in your own Hugging Face access token.
HF_TOKEN=hf_xxx_your_token_here

# Do not set DOCKER_HOST here. AC-Prof requires the native Ubuntu daemon at
# unix:///var/run/docker.sock and rejects WSL, Docker Desktop, and remote daemons.

# The official Hugging Face Hub is the default. A mirror requires explicit opt-in.
# HF_ENDPOINT=https://hf-mirror.com
# Optional fallback endpoints, tried in order; none are added implicitly.
# HF_FALLBACK_ENDPOINTS=https://huggingface.co
# Proxy settings, including NO_PROXY, are used as configured by the user.
# perf/tcpdump permissions are installed once by an administrator:
# docs/Getting_Started.md#最小权限安装

# Optional: Enterprise WeChat group-robot notifications. When configured,
# run.py enables WeCom by default (use --notify none to disable it). Keep the
# real Webhook in the ignored .env.local file; never commit or paste its key
# into logs or commands.
# ACPROF_WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key
